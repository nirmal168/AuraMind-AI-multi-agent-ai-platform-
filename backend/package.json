{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n \"gateway,auth,chat,agent,billing\" -c \"cyan,magenta,green,yellow,blue\" \"npm:dev:gateway\" \"npm:dev:auth\" \"npm:dev:chat\" \"npm:dev:agent\" \"npm:dev:billing\"",
    "dev:gateway": "cd gateway && npm run dev",
    "dev:auth": "cd services/auth && npm run dev",
    "dev:chat": "cd services/chat && npm run dev",
    "dev:agent": "cd services/agent && npm run dev",
    "dev:billing": "cd services/billing && npm run dev",
    "start": "concurrently -n \"gateway,auth,chat,agent,billing\" -c \"cyan,magenta,green,yellow,blue\" \"npm:start:gateway\" \"npm:start:auth\" \"npm:start:chat\" \"npm:start:agent\" \"npm:start:billing\"",
    "start:gateway": "cd gateway && npm start",
    "start:auth": "cd services/auth && npm start",
    "start:chat": "cd services/chat && npm start",
    "start:agent": "cd services/agent && npm start",
    "start:billing": "cd services/billing && npm start"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "mongoose": "^9.9.1",
    "nodemon": "^3.1.14"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
